{
    "name": "opotopo/bitrix-seller-api",
    "description": "Выгрузка каталога магазина 1С-Битрикс на площадку ОПОТОПО через Seller API",
    "type": "bitrix-module",
    "license": "MIT",
    "keywords": [
        "bitrix",
        "1c-bitrix",
        "opotopo",
        "seller-api",
        "catalog",
        "marketplace"
    ],
    "support": {
        "source": "https://github.com/AdzerKI/bitrix-seller-api"
    },
    "require": {
        "php": "^8.2"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "1c-bitrix/small-business",
                "version": "26.150.0",
                "dist": {
                    "url": "https://www.1c-bitrix.ru/download/files/small_business_encode.tar.gz",
                    "type": "file",
                    "shasum": "0977b2631addb3e22c981c95f7fd507b3c28c14a"
                }
            }
        }
    ],
    "require-dev": {
        "1c-bitrix/small-business": "26.150.0",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/process": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Masstech\\Opotopo\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masstech\\Opotopo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build-deps": [
            "@composer update --no-interaction --no-progress --working-dir=tools",
            "@composer update --no-dev --no-interaction --no-progress --working-dir=deps",
            "@composer reinstall opotopo/seller-api --no-interaction --no-progress --working-dir=deps",
            "tools/vendor/bin/php-scoper add-prefix --working-dir=deps --output-dir=../vendor-prefixed --force --no-interaction --quiet",
            "@composer dump-autoload --no-dev --classmap-authoritative --no-interaction --working-dir=vendor-prefixed"
        ],
        "post-install-cmd": "@build-deps",
        "post-update-cmd": "@build-deps"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
